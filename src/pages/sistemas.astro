---
// Página índice de sistemas por rubro.
// Intención: "sistemas para negocios en Honduras", "sistema para farmacias", "sistema para
// distribuidoras", etc. Reúne todos los sistemas y enlaza a la página propia de cada uno
// cuando existe. La lista vive en src/data/sistemas.ts (la comparte con el menú).
import Layout from '../layouts/Layout.astro';
import { sistemas, svgSistema, whatsappSistema } from '../data/sistemas';

const URL_PAGINA = 'https://olympohn.com/sistemas/';

const porQue = [
  { title: 'Hechos para Honduras',
    desc: 'Lempiras, ISV y facturación conforme a los requisitos del SAR. No es un sistema extranjero traducido.' },
  { title: 'Se adaptan a tu operación',
    desc: 'Partimos de un sistema que ya funciona en tu rubro y lo ajustamos a cómo trabaja tu negocio.' },
  { title: 'Soporte local, en tu idioma',
    desc: 'Estamos en Santa Rosa de Copán y atendemos todo el país. Hablás con quien construyó tu sistema.' },
];

const faqs = [
  {
    question: '¿Qué sistemas ofrece Olympo Code?',
    answer: 'Sistemas por rubro para negocios en Honduras: punto de venta para comercios, restaurantes y bares, farmacias, repuestos y celulares, lotificadoras, distribuidoras con rutas, clínicas y consultorios, y control de asistencia con reloj biométrico. Si tu rubro no está en la lista, lo construimos a la medida.',
  },
  {
    question: '¿Los sistemas de venta emiten factura con CAI?',
    answer: 'Sí. Nuestros sistemas de venta manejan la facturación conforme a los requisitos fiscales de Honduras: CAI, rango autorizado e ISV. En cada caso vemos con tu contador cómo factura hoy tu negocio.',
  },
  {
    question: '¿Qué pasa si mi tipo de negocio no aparece?',
    answer: 'Lo construimos a la medida. Analizamos cómo trabaja tu negocio, te mostramos qué parte ya tenemos resuelta en otros sistemas y te entregamos una propuesta clara. La primera consulta es gratuita.',
  },
  {
    question: '¿Atienden negocios fuera de Santa Rosa de Copán?',
    answer: 'Sí. Nuestra sede está en Santa Rosa de Copán y trabajamos con negocios en todo Honduras. La presentación, la capacitación y el soporte pueden ser presenciales o remotos.',
  },
];

const schemaSistemas = [{
  '@type': 'ItemList',
  '@id':   `${URL_PAGINA}#sistemas`,
  name:    'Sistemas para negocios en Honduras — Olympo Code',
  itemListElement: sistemas.map((s, i) => ({
    '@type':  'ListItem',
    position: i + 1,
    name:     s.nombre,
    url:      s.href ? `https://olympohn.com${s.href}/` : `${URL_PAGINA}#${s.id}`,
  })),
}];
---

<Layout
  title="Sistemas para Negocios en Honduras | Olympo Code"
  description="Sistemas para negocios en Honduras: punto de venta, restaurantes y bares, farmacias, repuestos, lotificadoras, distribuidoras, clínicas y control de asistencia."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Sistemas para Negocios en Honduras', url: '/sistemas' },
  ]}
  faq={faqs}
  schema={schemaSistemas}
>

<div class="sis-page">
  <div class="container">

    <!-- Hero -->
    <div class="sis-hero">
      <p class="label-tag">Sistemas · Honduras</p>
      <h1 class="sis-title">
        Un sistema para cada<br/>
        <span class="sis-em">tipo de negocio.</span>
      </h1>
      <p class="sis-lead">
        Estos son los sistemas que ya tenemos funcionando en negocios de Honduras.
        Buscá tu rubro, mirá para qué sirve y pedinos una presentación.
      </p>
    </div>

    <!-- Sistemas -->
    <section aria-label="Sistemas por rubro">
      <ul class="sis-grid">
        {sistemas.map(s => (
          <li class="sis-card" id={s.id}>
            <div class="sis-card-top">
              <span class="sis-card-icon" set:html={svgSistema(s.icono)} />
              {s.href && <span class="sis-card-tag">Con página propia</span>}
            </div>
            <h2 class="sis-card-title">{s.nombre}</h2>
            <p class="sis-card-para"><span>Para:</span> {s.paraQuien}</p>
            <p class="sis-card-desc">{s.desc}</p>
            <ul class="sis-card-puntos">
              {s.puntos.map(p => <li>{p}</li>)}
            </ul>
            {s.href
              ? <a href={s.href} class="sis-card-btn sis-card-btn-gold">Ver el sistema <span aria-hidden="true">→</span></a>
              : <a href={whatsappSistema(s.nombre)} class="sis-card-btn" target="_blank" rel="noopener nofollow">Solicitar información <span aria-hidden="true">→</span></a>
            }
          </li>
        ))}

        <!-- ¿No está tu rubro? -->
        <li class="sis-card sis-card-medida">
          <div class="sis-card-top">
            <span class="sis-card-icon" set:html={svgSistema('<path d="M7 6.5L3.5 10 7 13.5M13 6.5l3.5 3.5-3.5 3.5M11.5 4.5l-3 11"/>')} />
          </div>
          <h2 class="sis-card-title">¿No ves tu rubro?</h2>
          <p class="sis-card-desc">
            Lo construimos a la medida. Te mostramos qué parte ya tenemos resuelta en otros
            sistemas y te entregamos una propuesta clara.
          </p>
          <a href="/servicios#software-medida" class="sis-card-btn">Software a medida <span aria-hidden="true">→</span></a>
        </li>
      </ul>
    </section>

    <!-- Por qué -->
    <section class="sis-why reveal">
      <h2 class="sis-h2">Por qué un sistema de Olympo</h2>
      <div class="sis-why-grid">
        {porQue.map(p => (
          <div class="sis-why-item">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="sis-faq reveal">
      <h2 class="sis-h2">Preguntas frecuentes</h2>
      <div class="sis-faq-list">
        {faqs.map(f => (
          <details class="sis-faq-item">
            <summary class="sis-faq-q">{f.question}</summary>
            <p class="sis-faq-a">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="sis-cta reveal">
      <h2 class="sis-cta-title">Contanos de tu negocio y te mostramos el sistema.</h2>
      <p class="sis-cta-desc">Primera consulta gratis, sin compromiso. Presencial en Copán o por videollamada en todo Honduras.</p>
      <div class="sis-actions">
        <a href="/contacto" class="btn btn-primary btn-lg">Solicitar presentación</a>
        <a href="https://wa.me/50433012826" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener nofollow">WhatsApp →</a>
      </div>
    </section>

  </div>
</div>

</Layout>

<style>
  .sis-page { padding: 5rem 0 7rem; }

  .sis-hero {
    text-align: center; max-width: 700px; margin: 0 auto 3.5rem;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
    padding-top: 3rem;
  }
  .sis-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700; letter-spacing: -0.04em; line-height: 1.08; color: var(--text-1);
  }
  .sis-em {
    font-style: italic; padding-right: 0.08em;
    background: linear-gradient(115deg, #f0d080, #c8a040 40%, #e8b860 70%, #9a6a28);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .sis-lead { font-size: 0.98rem; color: var(--text-2); line-height: 1.75; font-weight: 300; max-width: 560px; }

  /* Tarjetas */
  .sis-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 980px) { .sis-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .sis-grid { grid-template-columns: minmax(0, 1fr); } }

  .sis-card {
    position: relative; display: flex; flex-direction: column;
    border: 1px solid var(--border); border-radius: 16px;
    background: var(--bg-1); padding: 1.5rem;
    scroll-margin-top: 100px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sis-card:hover { border-color: var(--border-gold); transform: translateY(-3px); box-shadow: 0 20px 44px rgba(0,0,0,0.4); }
  .sis-card:target { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold), 0 0 40px rgba(200,169,110,0.18); }

  .sis-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .sis-card-icon {
    width: 44px; height: 44px; border-radius: 11px;
    border: 1px solid var(--border-gold); background: var(--gold-subtle);
    display: flex; align-items: center; justify-content: center; color: var(--gold-bright);
  }
  .sis-card-tag {
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #4ade80; background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.22);
    border-radius: 100px; padding: 0.16rem 0.55rem;
  }
  .sis-card-title { font-size: 1.08rem; font-weight: 600; color: var(--text-1); line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 0.45rem; }
  .sis-card-para  { font-size: 0.78rem; color: var(--gold); line-height: 1.55; margin-bottom: 0.7rem; }
  .sis-card-para span { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); margin-right: 0.2rem; }
  .sis-card-desc  { font-size: 0.85rem; color: var(--text-2); line-height: 1.7; font-weight: 300; margin-bottom: 0.9rem; }

  .sis-card-puntos { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.3rem; }
  .sis-card-puntos li { position: relative; padding-left: 1.3rem; font-size: 0.8rem; color: var(--text-1); line-height: 1.5; }
  .sis-card-puntos li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 700; font-size: 0.78rem; }

  .sis-card-btn {
    margin-top: auto; display: block; text-align: center;
    font-size: 0.8rem; font-weight: 600; color: var(--text-1);
    border: 1px solid var(--border-hover); border-radius: 9px; padding: 0.55rem 0.7rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .sis-card-btn:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.25); }
  .sis-card-btn-gold { color: var(--gold-bright); border-color: var(--border-gold); background: var(--gold-subtle); }
  .sis-card-btn-gold:hover { background: linear-gradient(135deg, #e2c07a, #b8924e); color: #120d04; border-color: transparent; }

  .sis-card-medida {
    border-style: dashed; border-color: var(--border-gold);
    background: radial-gradient(ellipse at 50% 0%, rgba(200,169,110,0.08), transparent 65%), var(--bg-1);
  }
  .sis-card-medida .sis-card-desc { margin-bottom: 1.3rem; }

  /* Secciones */
  .sis-h2 {
    font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.03em;
    color: var(--text-1); text-align: center; margin-bottom: 2.25rem;
  }
  .sis-why { margin-top: 5.5rem; }
  .sis-why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
  .sis-why-item { padding: 0.25rem 1.5rem; border-left: 2px solid var(--gold); }
  .sis-why-item h3 { font-size: 0.95rem; font-weight: 600; color: var(--text-1); margin-bottom: 0.5rem; }
  .sis-why-item p  { font-size: 0.83rem; color: var(--text-2); line-height: 1.7; font-weight: 300; }

  .sis-faq { margin: 5.5rem auto 0; max-width: 740px; }
  .sis-faq-list { display: flex; flex-direction: column; }
  .sis-faq-item { border-bottom: 1px solid var(--border); padding: 1.25rem 0; }
  .sis-faq-q {
    font-size: 0.95rem; font-weight: 500; color: var(--text-1); cursor: pointer; list-style: none;
    display: flex; justify-content: space-between; align-items: center;
  }
  .sis-faq-q::-webkit-details-marker { display: none; }
  .sis-faq-q::after { content: '+'; font-size: 1.2rem; color: var(--text-3); flex-shrink: 0; margin-left: 1rem; }
  details[open] .sis-faq-q::after { content: '−'; }
  .sis-faq-a { font-size: 0.86rem; color: var(--text-2); line-height: 1.75; font-weight: 300; margin-top: 0.75rem; padding-right: 2rem; }

  .sis-cta {
    margin-top: 5.5rem; text-align: center; padding: 3rem 1.5rem;
    border: 1px solid var(--border-gold); border-radius: 16px;
    background: radial-gradient(ellipse at 50% 0%, rgba(200,169,110,0.10), transparent 60%), var(--bg-1);
  }
  .sis-cta-title { font-size: clamp(1.35rem, 3vw, 1.8rem); font-weight: 700; color: var(--text-1); margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .sis-cta-desc  { font-size: 0.92rem; color: var(--text-2); line-height: 1.7; font-weight: 300; max-width: 520px; margin: 0 auto 1.6rem; }
  .sis-actions   { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
</style>
