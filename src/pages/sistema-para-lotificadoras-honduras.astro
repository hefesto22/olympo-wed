const L = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
// La cuota se redondea hacia arriba a un número cerrado (acá, múltiplos de L 10).
const cuotaDe = (valor: number, meses: number) =>
  meses === 0 ? 0 : Math.ceil(((valor * (1 - PRIMA_PCT)) / meses) / 10) * 10;

const r1 = (n: number) => Math.round(n * 10) / 10;
const lotes: LoteDemo[] = [];

// Manzana A — dos filas de 7 lotes rectangulares
const estadosA: Estado[][] = [
  ['vendido', 'vendido', 'apartado', 'disponible', 'vendido', 'disponible', 'vendido'],
  ['vendido', 'disponible', 'vendido', 'vendido', 'apartado', 'vendido', 'disponible'],
];
const areasA = [250, 250, 262.5, 250, 250, 237.5, 281.25];
{
  const x0 = 14, x1 = 306, w = (x1 - x0) / 7;
  const filas = [[14, 57], [57, 100]];
  let n = 1;
  filas.forEach(([ya, yb], f) => {
    for (let i = 0; i < 7; i++) {
      const xa = r1(x0 + i * w), xb = r1(x0 + (i + 1) * w);
      const num = String(n++).padStart(3, '0');
      lotes.push({
        codigo: `RDM-A-${num}`, num,
        estado: estadosA[f][i],
        area: areasA[i],
        puntos: `${xa},${ya} ${xb},${ya} ${xb},${yb} ${xa},${yb}`,
        cx: r1((xa + xb) / 2), cy: (ya + yb) / 2,
      });
    }
  });
}

// Manzana B — lindero derecho en diagonal: los lotes salen como cuadriláteros irregulares
const estadosB: Estado[][] = [
  ['disponible', 'disponible', 'vendido', 'disponible', 'apartado', 'disponible'],
  ['disponible', 'vendido', 'disponible', 'disponible', 'disponible', 'vendido'],
];
const areasB = [[312.4, 305.1, 297.85, 290.6, 283.3, 276.05], [268.8, 261.5, 254.25, 250, 239.75, 232.5]];
{
  const x0 = 14, yT = 124, yM = 170, yB = 216;
  const xDer = (y: number) => 292 - ((y - yT) / (yB - yT)) * 26; // 292 arriba → 266 abajo
  const xEn = (i: number, y: number) => r1(x0 + (i / 6) * (xDer(y) - x0));
  let n = 1;
  [[yT, yM], [yM, yB]].forEach(([ya, yb], f) => {
    for (let i = 0; i < 6; i++) {
      const num = String(n++).padStart(3, '0');
      const xs = [xEn(i, ya), xEn(i + 1, ya), xEn(i + 1, yb), xEn(i, yb)];
      lotes.push({
        codigo: `RDM-B-${num}`, num,
        estado: estadosB[f][i],
        area: areasB[f][i],
        puntos: `${xs[0]},${ya} ${xs[1]},${ya} ${xs[2]},${yb} ${xs[3]},${yb}`,
        cx: r1((xs[0] + xs[1] + xs[2] + xs[3]) / 4), cy: (ya + yb) / 2,
      });
    }
  });
}

