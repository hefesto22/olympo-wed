  {
    question: '¿Atienden lotificadoras fuera de Santa Rosa de Copán?',
    answer: 'Sí. Nuestra sede está en Santa Rosa de Copán y trabajamos con lotificadoras en todo Honduras: Copán, San Pedro Sula, Tegucigalpa, Comayagua, La Ceiba y más. La presentación, la capacitación y el soporte pueden ser presenciales o remotos.',
  },
];

// Schema del producto. Se usa Service y no SoftwareApplication a propósito:
// Google exige precio y reseñas para SoftwareApplication y, sin ellos, Search
// Console lo marca como error. No publicamos precio ni inventamos reseñas.
const schemaProducto = [{
  '@type':       'Service',
  '@id':         `${URL_PAGINA}#servicio`,
  name:          'Olympo Lotificaciones',
  alternateName: ['Sistema para lotificadoras', 'Software para lotificadoras en Honduras'],
  serviceType:   'Software de gestión para lotificadoras y venta de lotes a plazos',
  category:      'Software inmobiliario',
  url:           URL_PAGINA,
  description:   'Sistema para lotificadoras en Honduras: plano interactivo de lotes, apartados, ventas a plazos, cuotas, interés y mora, recibos, cobranza diaria, comisiones, facturación con CAI y cierre mensual.',
  provider:      { '@id': 'https://olympohn.com/#organization' },
  areaServed:    { '@type': 'Country', name: 'Honduras' },
  audience:      { '@type': 'BusinessAudience', audienceType: 'Lotificadoras, residenciales y desarrolladores inmobiliarios' },
  inLanguage:    'es-HN',
}];
---

<Layout
  title="Sistema para Lotificadoras en Honduras | Olympo Lotificaciones"
  description="Software para lotificadoras en Honduras: plano interactivo de lotes, ventas a plazos, cuotas, mora, recibos y cobranza diaria. Solicitá una presentación."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Sistema para Lotificadoras en Honduras', url: '/sistema-para-lotificadoras-honduras' },
  ]}
  faq={faqs}
  schema={schemaProducto}
>

<div class="lt-page">

  <!-- ═══════════ HERO ═══════════ -->
  <section class="lt-hero">
    <div class="lt-hero-glow" aria-hidden="true"></div>
    <div class="container lt-hero-grid">

      <div class="lt-hero-copy">
        <p class="label-tag">Olympo Lotificaciones · Honduras</p>
        <h1 class="lt-title">
          Sistema para lotificadoras<br/>
          <span class="lt-em">del plano al último recibo.</span>
        </h1>
        <p class="lt-lead">
          El software para lotificadoras y residenciales en Honduras. Vendé desde un plano
          interactivo, controlá apartados, contratos, cuotas, mora y recibos, y sabé cada
          mañana a quién hay que cobrarle. Sin Excel, sin cuadernos y sin recibos perdidos.
        </p>
        <div class="lt-actions">
          <a href={CONTACTO} class="btn btn-primary btn-lg">Solicitar presentación</a>
          <a href={WHATSAPP} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener nofollow">Escribir por WhatsApp →</a>
        </div>
        <p class="lt-hero-note">
          <span class="lt-live-dot" aria-hidden="true"></span>
          En producción · {proyectos.length} proyectos · más de {lotesRedondo} lotes en Honduras
        </p>
      </div>

      <!-- Mockup: plano interactivo -->
      <figure class="lt-mock" aria-label="Ejemplo del plano interactivo de Olympo Lotificaciones: lotes disponibles, apartados y vendidos, con el precio y la cuota del lote seleccionado">
        <div class="lt-mock-bar" aria-hidden="true">
          <div class="lt-dots"><span></span><span></span><span></span></div>
          <div class="lt-mock-title">olympo — lotificaciones</div>
          <div class="lt-mock-live"><span class="lt-live-dot"></span>plano</div>
        </div>

        <div class="lt-mock-body" aria-hidden="true">
          <div class="lt-plano">
            <div class="lt-plano-top">
              <span class="lt-proy">Residencial Demo <small>▾</small></span>
              <span class="lt-legend">
                <i class="lg lg-disponible"></i>Disponible
                <i class="lg lg-apartado"></i>Apartado
                <i class="lg lg-vendido"></i>Vendido
              </span>
            </div>
            <svg class="lt-svg" viewBox="0 0 320 230" id="lt-plano-svg">
              <text x="14" y="9" class="lt-mz">MANZANA A</text>
              <text x="160" y="115" class="lt-calle" text-anchor="middle">CALLE PRINCIPAL</text>
              <text x="14" y="227" class="lt-mz">MANZANA B</text>
              <polygon class="lt-verde" points="296,124 306,124 306,216 270,216" />
              <text x="299" y="196" class="lt-verde-txt" transform="rotate(-90 299 196)">ÁREA VERDE</text>
              {lotes.map(l => (
                <polygon
                  class:list={['lt-lot', `is-${l.estado}`, { 'is-sel': l.codigo === LOTE_INICIAL }]}
                  points={l.puntos}
                  data-codigo={l.codigo}
                  data-estado={l.estado}
                  data-area={l.area}
                />
              ))}
              {lotes.map(l => (
                <text x={l.cx} y={l.cy + 2.4} class="lt-lot-n" text-anchor="middle">{l.num}</text>
              ))}
            </svg>
          </div>

          <div class="lt-panel" id="lt-panel" data-precio={PLAN_DEMO.precio} data-meses={PLAN_DEMO.meses} data-prima={PRIMA_PCT}>
            <div class="lt-panel-head">
              <span class="lt-panel-code" id="lt-p-codigo">{loteSel.codigo}</span>
              <span class:list={['lt-badge', `is-${loteSel.estado}`]} id="lt-p-estado">{etiquetaEstado[loteSel.estado]}</span>
            </div>
            <dl class="lt-panel-rows">
              <div><dt>Área</dt><dd><span id="lt-p-area">{L(loteSel.area)}</span> vr²</dd></div>
              <div><dt>Precio vr²</dt><dd>L {L(PLAN_DEMO.precio)}</dd></div>
              <div class="lt-row-total"><dt>Valor</dt><dd>L <span id="lt-p-valor">{L(valorSel)}</span></dd></div>
              <div><dt>Prima 30 %</dt><dd>L <span id="lt-p-prima">{L(valorSel * PRIMA_PCT)}</span></dd></div>
              <div><dt>{PLAN_DEMO.meses} cuotas de</dt><dd class="lt-gold">L <span id="lt-p-cuota">{L(cuotaDe(valorSel, PLAN_DEMO.meses))}</span></dd></div>
            </dl>
            <p class="lt-panel-note" id="lt-p-nota">{notaEstado[loteSel.estado]}</p>
            <div class="lt-panel-btns" id="lt-p-btns">
              <span class="lt-pbtn">Apartar</span>
              <span class="lt-pbtn lt-pbtn-gold">Vender →</span>
            </div>
          </div>
        </div>
        <figcaption class="lt-mock-cap"><span class="lt-cap-largo">Datos de demostración. </span>Tocá un lote para ver su precio y su cuota.</figcaption>
      </figure>

    </div>
  </section>

  <div class="container">

    <!-- Hecho para Honduras -->
    <ul class="lt-chips" aria-label="Hecho para Honduras">
      {hechoParaHN.map(c => <li class="lt-chip">{c}</li>)}
    </ul>

    <!-- ═══════════ AFILIADOS ═══════════ -->
    <section class="lt-section lt-clientes reveal" id="afiliados">
      <div class="lt-clientes-glow" aria-hidden="true"></div>
      <p class="label-tag lt-center">Afiliados</p>
      <h2 class="lt-h2">Lotificaciones que ya <span class="lt-em">trabajan con el sistema</span></h2>
      <p class="lt-sub">
        {proyectos.length} proyectos en Copán y más de {lotesRedondo} lotes entre todos. Sus planos públicos están
        en línea: abrí cualquiera y mirá el sistema funcionando de verdad, con lotes reales.
      </p>
      <ul class="lt-proyectos">
        {proyectos.map(p => (
          <li>
            <a href={p.url} class="lt-proyecto" target="_blank" rel="noopener" aria-label={`${p.nombre}, ${p.lugar}: ${p.lotes} lotes. Ver su plano público en vivo`}>
              <span class="lt-proyecto-mapa" aria-hidden="true">
                <svg class="lt-mini" viewBox="0 0 200 112" preserveAspectRatio="xMidYMid slice">
                  {p.celdas.map(c => (
                    <polygon points={c.puntos} class:list={['lt-celda', `t${c.tono}`]} style={c.tono === 3 ? `animation-delay:${c.demora}s` : undefined} />
                  ))}
                </svg>
                <span class="lt-proyecto-live"><i></i>En línea</span>
              </span>
              <span class="lt-proyecto-body">
                <span class="lt-proyecto-num"><b data-lt-count={p.lotes}>{p.lotes}</b><small>lotes</small></span>
                <strong class="lt-proyecto-nombre">{p.nombre}</strong>
                <span class="lt-proyecto-lugar"><span set:html={iconoPin} />{p.lugar}</span>
                <span class="lt-proyecto-btn">Ver plano en vivo <span aria-hidden="true">↗</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="lt-desliza" aria-hidden="true">Deslizá para ver los {proyectos.length} →</p>
    </section>

    <!-- ═══════════ LA VIDA DE UN LOTE (compacta) ═══════════ -->
    <section class="lt-section reveal">
      <p class="label-tag lt-center">Cómo funciona</p>
      <h2 class="lt-h2">La vida de un lote, de principio a fin</h2>
      <ol class="lt-flow">
        {vidaDelLote.map(p => (
          <li class="lt-flow-step">
            <span class="lt-flow-n">{p.n}</span>
            <div>
              <h3 class="lt-flow-title">{p.title}</h3>
              <p class="lt-flow-desc">{p.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ═══════════ MÓDULOS (pestañas) ═══════════
         Vender, Cobrar, Administrar y Control en una sola sección: la página queda corta
         y todo el contenido sigue en el HTML (Google lo lee igual). -->
    <section class="lt-section reveal" id="modulos">
      <p class="label-tag lt-center">Qué incluye</p>
      <h2 class="lt-h2">Todo el negocio de tu lotificadora, <span class="lt-em">en un solo sistema</span></h2>

      <div class="lt-tabs" role="tablist" aria-label="Módulos del sistema">
        {pestanas.map((t, i) => (
          <button
            type="button" role="tab" class="lt-tab"
            id={`tab-${t.id}`} aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          >{t.label}</button>
        ))}
      </div>

      <!-- Vender -->
      <div class="lt-tabpanel" role="tabpanel" id="panel-vender" aria-labelledby="tab-vender">
        <div class="lt-split">
          <div class="lt-split-copy">
            <h3 class="lt-h3">Vendé lotes desde el plano, no desde una hoja de cálculo</h3>
            <p class="lt-h3-sub">El plano es la pantalla de trabajo, y su versión pública es tu vitrina en el celular del comprador.</p>
          <ul class="lt-feats">
            {modVender.map(m => (
              <li class="lt-feat">
                <span class="lt-feat-icon" set:html={m.icon} />
                <div>
                  <h4 class="lt-feat-title">{m.title}</h4>
                  <p class="lt-feat-desc">{m.desc}</p>
                </div>
              </li>
            ))}
          </ul>
          </div>

        <!-- Mockup: plano público en el teléfono -->
        <figure class="lt-phone" aria-label="Ejemplo del plano público visto desde un celular, con el precio y la cuota de un lote según el plazo">
          <div class="lt-phone-screen" aria-hidden="true">
            <div class="lt-ph-head">
              <strong>Residencial Demo</strong>
              <span>{disponibles} lotes disponibles</span>
            </div>
            <svg class="lt-svg lt-ph-svg" viewBox="0 0 320 230">
              <polygon class="lt-verde" points="296,124 306,124 306,216 270,216" />
              {lotes.map(l => (
                <polygon class:list={['lt-lot', `is-${l.estado}`, { 'is-sel': l.codigo === LOTE_INICIAL }]} points={l.puntos} />
              ))}
            </svg>
            <div class="lt-ph-sheet">
              <div class="lt-ph-sheet-head">
                <strong>Lote B-010</strong>
                <span>{L(loteSel.area)} vr²</span>
              </div>
              <ul class="lt-ph-planes">
                {planes.map(p => {
                  const valor = loteSel.area * p.precio;
                  return (
                    <li class:list={[{ 'is-on': p.meses === PLAN_DEMO.meses }]}>
                      <span>{p.etiqueta}</span>
                      <span>L {L(valor)}</span>
                      <span class="lt-ph-cuota">{p.meses === 0 ? '—' : `L ${L(cuotaDe(valor, p.meses))}/mes`}</span>
                    </li>
                  );
                })}
              </ul>
              <span class="lt-ph-btn">Preguntar por este lote</span>
            </div>
          </div>
        </figure>
        </div>
      </div>

      <!-- Cobrar -->
      <div class="lt-tabpanel" role="tabpanel" id="panel-cobrar" aria-labelledby="tab-cobrar" hidden>
        <div class="lt-split">
          <div class="lt-split-copy">
            <h3 class="lt-h3">Control de cuotas y cobranza, todos los días</h3>
            <p class="lt-h3-sub">«Por cobrar hoy» le dice a tu equipo a quién llamar, cuánto debe y qué contestó la última vez.</p>
          <ul class="lt-feats">
            {modCobrar.map(m => (
              <li class="lt-feat">
                <span class="lt-feat-icon" set:html={m.icon} />
                <div>
                  <h4 class="lt-feat-title">{m.title}</h4>
                  <p class="lt-feat-desc">{m.desc}</p>
                </div>
              </li>
            ))}
          </ul>
          </div>

        <!-- Mockup: Por cobrar hoy -->
        <figure class="lt-cobro" aria-label="Ejemplo de la pantalla Por cobrar hoy: clientes con cuotas vencidas o que vencen hoy y cuánto debe cada uno">
          <div class="lt-mock-bar" aria-hidden="true">
            <div class="lt-dots"><span></span><span></span><span></span></div>
            <div class="lt-mock-title">Por cobrar hoy</div>
            <div class="lt-mock-count">4 pendientes</div>
          </div>
          <div class="lt-cobro-body" aria-hidden="true">
            <div class="lt-cobro-row lt-cobro-th">
              <span>A quién llamar</span><span>Situación</span><span>Debe a hoy</span>
            </div>
            <div class="lt-cobro-row">
              <span><b>CARLOS M.</b><small>EXP-000128</small></span>
              <span><em class="lt-sit lt-sit-red">3 cuotas vencidas</em></span>
              <span class="lt-num">L {L(3480 * 3)}</span>
            </div>
            <div class="lt-cobro-row">
              <span><b>ANA R.</b><small>EXP-000093</small></span>
              <span><em class="lt-sit lt-sit-red">2 cuotas vencidas</em></span>
              <span class="lt-num">L {L(4930 * 2)}</span>
            </div>
            <div class="lt-cobro-row">
              <span><b>JOSÉ L.</b><small>EXP-000141</small></span>
              <span><em class="lt-sit lt-sit-amber">Le toca hoy</em></span>
              <span class="lt-num">L {L(9480)}</span>
            </div>
            <div class="lt-cobro-row">
              <span><b>MARTA S.</b><small>EXP-000077</small></span>
              <span><em class="lt-sit lt-sit-amber">Le toca hoy</em></span>
              <span class="lt-num">L {L(3410)}</span>
            </div>
            <div class="lt-cobro-foot">
              <span class="lt-pbtn">Ya lo contacté</span>
              <span class="lt-pbtn lt-pbtn-gold">Cobrar →</span>
            </div>
          </div>
        </figure>
        </div>
      </div>

      <!-- Administrar -->
      <div class="lt-tabpanel" role="tabpanel" id="panel-administrar" aria-labelledby="tab-administrar" hidden>
        <h3 class="lt-h3 lt-h3-center">Lo que el dueño necesita saber, sin pedírselo a nadie</h3>
        <p class="lt-h3-sub lt-h3-center">Bajo qué autorización se factura, cuánto cuesta el desarrollo y quién hizo qué.</p>
        <ul class="lt-feats lt-feats-3">
            {modAdministrar.map(m => (
              <li class="lt-feat">
                <span class="lt-feat-icon" set:html={m.icon} />
                <div>
                  <h4 class="lt-feat-title">{m.title}</h4>
                  <p class="lt-feat-desc">{m.desc}</p>
                </div>
              </li>
            ))}
          </ul>
      </div>

      <!-- Control -->
      <div class="lt-tabpanel" role="tabpanel" id="panel-control" aria-labelledby="tab-control" hidden>
        <h3 class="lt-h3 lt-h3-center">Reglas que cuidan tu dinero</h3>
        <p class="lt-h3-sub lt-h3-center">Lo que el sistema no deja hacer, para que dentro de tres años los números sigan cuadrando.</p>
        <div class="lt-why-grid">
          {reglas.map(r => (
            <div class="lt-why-item">
              <h4>{r.title}</h4>
              <p>{r.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <noscript><style is:inline>.lt-tabpanel[hidden]{display:block!important;margin-top:3rem}.lt-tabs{display:none!important}</style></noscript>

      <!-- CTA a media página: que contactar no dependa de llegar al final -->
      <div class="lt-midcta">
        <p><strong>¿Querés verlo con tus propios lotes?</strong> Te lo mostramos funcionando en una reunión corta.</p>
        <div class="lt-actions">
          <a href={CONTACTO} class="btn btn-primary">Solicitar presentación</a>
          <a href={WHATSAPP} class="btn btn-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp →</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ IMPLEMENTACIÓN ═══════════ -->
    <section class="lt-section reveal">
      <p class="label-tag lt-center">Implementación</p>
      <h2 class="lt-h2">Cómo lo ponemos a funcionar en tu lotificadora</h2>
      <p class="lt-sub">
        Cada lotificadora recibe su propia instalación: su servidor, su dominio, su base de
        datos, su logo y sus colores.
      </p>
      <ol class="lt-flow lt-flow-4">
        {pasos.map(p => (
          <li class="lt-flow-step">
            <span class="lt-flow-n">{p.n}</span>
            <div>
              <h3 class="lt-flow-title">{p.title}</h3>
              <p class="lt-flow-desc">{p.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ═══════════ SERVICIO ADICIONAL: RECORRIDOS 360° ═══════════
         Es un servicio de Olympo que se contrata APARTE del sistema. No presentarlo como incluido. -->
    <section class="lt-section reveal" id="recorridos-360">
      <div class="lt-360">
        <div class="lt-360-copy">
          <p class="label-tag">Servicio adicional</p>
          <h2 class="lt-h2 lt-360-title">Recorridos virtuales 360° <span class="lt-em">de cada lote</span></h2>
          <p class="lt-360-lead">
            Nuestro equipo visita tu proyecto, captura cada lote en 360° y lo integra a tu plano
            público. Tus compradores recorren el terreno desde el celular, estén en Honduras o
            en el extranjero.
          </p>
          <ul class="lt-360-list">
            {beneficios360.map(b => <li>{b}</li>)}
          </ul>
          <div class="lt-360-cta">
            <a href={WHATSAPP_360} class="btn btn-primary" target="_blank" rel="noopener nofollow">Solicitar información</a>
            <span class="lt-360-nota">Se contrata aparte del sistema.</span>
          </div>
        </div>

        <!-- Visor de demostración (ilustración, no es una foto real) -->
        <figure class="lt-visor" aria-label="Ilustración de un recorrido virtual 360°: vista del terreno con el lote marcado">
          <svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="lt-cielo" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#090b10"/><stop offset="0.7" stop-color="#1f1a10"/><stop offset="1" stop-color="#7a5f2a"/>
              </linearGradient>
              <linearGradient id="lt-suelo" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2b2716"/><stop offset="1" stop-color="#0a0c08"/>
              </linearGradient>
              <radialGradient id="lt-sol" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0" stop-color="#f0d080" stop-opacity="0.75"/><stop offset="0.35" stop-color="#c8a96e" stop-opacity="0.28"/><stop offset="1" stop-color="#c8a96e" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <rect width="400" height="130" fill="url(#lt-cielo)"/>
            <circle cx="292" cy="128" r="78" fill="url(#lt-sol)"/>
            <g class="lt-visor-lejos">
              <path d="M-40 130 L-40 108 Q10 84 60 100 T150 92 T235 104 T330 86 T440 100 L440 130 Z" fill="#14140e"/>
              <path d="M-40 130 L-40 118 Q30 102 95 114 T205 108 T300 116 T440 106 L440 130 Z" fill="#1c1a10"/>
            </g>
            <rect y="128" width="400" height="122" fill="url(#lt-suelo)"/>
            <g stroke="rgba(200,169,110,0.2)" stroke-width="1">
              <path d="M200 128L-240 250M200 128L-40 250M200 128L120 250M200 128L280 250M200 128L440 250M200 128L640 250"/>
              <path d="M0 138H400M0 158H400M0 190H400M0 228H400"/>
            </g>
            <polygon points="180.3,158 219.7,158 265.6,228 134.4,228" fill="rgba(226,192,122,0.16)" stroke="#e2c07a" stroke-width="1.6" stroke-linejoin="round"/>
            <g stroke="#e2c07a" stroke-width="1.4" stroke-linecap="round">
              <path d="M180.3 158v-9M219.7 158v-9M265.6 228v-15M134.4 228v-15"/>
            </g>
            <path d="M200 176V132" stroke="#e2c07a" stroke-width="1" stroke-dasharray="2 3"/>
            <circle cx="200" cy="178" r="3" fill="#e2c07a"/>
            <g>
              <rect x="122" y="106" width="156" height="24" rx="12" fill="rgba(8,8,8,0.82)" stroke="rgba(226,192,122,0.55)"/>
              <text x="200" y="122" text-anchor="middle" class="lt-visor-txt">LOTE B-010 · 250.00 vr²</text>
            </g>
          </svg>
          <span class="lt-visor-badge" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10c0-2.2 3.1-4 7-4s7 1.8 7 4-3.1 4-7 4"/><path d="M8 11.5L10.5 14 8 16.5"/></svg>
            360°
          </span>
          <span class="lt-visor-hint" aria-hidden="true">‹ Arrastrá para mirar alrededor ›</span>
        </figure>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="lt-section lt-faq reveal">
