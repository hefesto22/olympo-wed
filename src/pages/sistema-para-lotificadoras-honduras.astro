<script>
  // Afiliados: el número de lotes cuenta desde cero cuando la tarjeta entra en pantalla.
  // Sin JS (o con movimiento reducido) queda el número final, que ya viene en el HTML.
  const contadores = document.querySelectorAll<HTMLElement>('[data-lt-count]');
  if (contadores.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const verContador = new IntersectionObserver((entradas) => {
      entradas.forEach((entrada) => {
        if (!entrada.isIntersecting) return;
        verContador.unobserve(entrada.target);
        const el  = entrada.target as HTMLElement;
        const fin = Number(el.dataset.ltCount);
        const t0  = performance.now();
        const paso = (t: number) => {
          const k = Math.min(1, (t - t0) / 1100);
          el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      });
    }, { threshold: 0.5 });
    contadores.forEach((c) => verContador.observe(c));
  }

  // Pestañas de módulos: clic o flechas del teclado. Un solo panel visible a la vez.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.lt-tab'));
  const activar = (tab: HTMLButtonElement, foco = false) => {
    tabs.forEach((t) => {
      const activa = t === tab;
      t.setAttribute('aria-selected', String(activa));
      t.tabIndex = activa ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !activa;
    });
    if (foco) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activar(tab));
    tab.addEventListener('keydown', (e) => {
      const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!paso) return;
      e.preventDefault();
      activar(tabs[(i + paso + tabs.length) % tabs.length], true);
    });
  });

  // Plano de demostración: al tocar un lote, el panel muestra su precio y su cuota.
  // Sin framework a propósito: son 26 polígonos y seis textos.
  const plano = document.getElementById('lt-plano-svg');
  const panel = document.getElementById('lt-panel');

  if (plano && panel) {
    const precio = Number(panel.dataset.precio);
    const meses  = Number(panel.dataset.meses);
    const prima  = Number(panel.dataset.prima);
    const fmt    = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const set    = (id: string, txt: string) => { const el = document.getElementById(id); if (el) el.textContent = txt; };

    const etiquetas: Record<string, string> = { disponible: 'Disponible', apartado: 'Apartado', vendido: 'Vendido' };
    const notas: Record<string, string> = {
      disponible: 'Se puede apartar o vender desde aquí.',
      apartado:   'Con seña. No se le vende a nadie más mientras esté vigente.',
      vendido:    'Contrato firmado: precio y área congelados.',
    };

    plano.addEventListener('click', (e) => {
      const lote = (e.target as Element).closest<SVGPolygonElement>('.lt-lot');
      if (!lote) return;

      const estado = lote.dataset.estado ?? 'disponible';
      const area   = Number(lote.dataset.area);
      const valor  = area * precio;
      const cuota  = Math.ceil(((valor * (1 - prima)) / meses) / 10) * 10;

      plano.querySelectorAll('.lt-lot.is-sel').forEach(el => el.classList.remove('is-sel'));
      lote.classList.add('is-sel');

      set('lt-p-codigo', lote.dataset.codigo ?? '');
      set('lt-p-area',   fmt(area));
      set('lt-p-valor',  fmt(valor));
      set('lt-p-prima',  fmt(valor * prima));
      set('lt-p-cuota',  fmt(cuota));
      set('lt-p-nota',   notas[estado]);

      const badge = document.getElementById('lt-p-estado');
      if (badge) {
        badge.textContent = etiquetas[estado];
        badge.className = badge.className.replace(/is-(disponible|apartado|vendido)/, `is-${estado}`);
      }
      const btns = document.getElementById('lt-p-btns');
      if (btns) btns.classList.toggle('is-off', estado !== 'disponible');
    });
  }
</script>

