      { x: 136, y: 50, cols: 3,  rows: 2, cw: 14, ch: 18 },
    ] },
].map((p, semilla) => {
  const rad = (g: number) => (g * Math.PI) / 180;
  const girar = (px: number, py: number, ox: number, oy: number, g: number) => {
    const c = Math.cos(rad(g)), s = Math.sin(rad(g));
    return [ox + (px - ox) * c - (py - oy) * s, oy + (px - ox) * s + (py - oy) * c];
  };
  let i = 0;
  const celdas = p.bloques.flatMap(b => {
    const out: { puntos: string; tono: number; demora: number }[] = [];
    for (let f = 0; f < b.rows; f++) for (let c = 0; c < b.cols; c++) {
      const x0 = b.x + c * b.cw, y0 = b.y + f * b.ch;
      const puntos = [[x0, y0], [x0 + b.cw, y0], [x0 + b.cw, y0 + b.ch], [x0, y0 + b.ch]]
        .map(([px, py]) => girar(px, py, b.x, b.y, b.rot ?? 0))
        .map(([px, py]) => girar(px, py, 100, 56, p.giro))
        .map(([px, py]) => `${r1(px)},${r1(py)}`).join(' ');
      // tono 0-1: lote normal · 2: resaltado · 3: brillante (parpadea)
      const n = (i * 7 + semilla * 13 + f * 3) % 10;
      out.push({ puntos, tono: n < 5 ? 0 : n < 7 ? 1 : n < 9 ? 2 : 3, demora: (i % 6) * 0.55 });
      i++;
    }
    return out;
  });
  return { ...p, celdas };
});
